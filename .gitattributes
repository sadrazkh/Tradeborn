# Normalise line endings so Windows/Linux/CI agree.
* text=auto eol=lf

*.sln        text eol=crlf
*.slnx       text eol=crlf
*.csproj     text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf

*.sh         text eol=lf

# Binary assets — never diff or normalise.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.ktx2       binary
*.basis      binary
*.glb        binary
*.gltf       binary
*.bin        binary
*.mp3        binary
*.ogg        binary
*.wav        binary
*.woff       binary
*.woff2      binary

# Generated files: collapse in PR diffs.
package-lock.json  linguist-generated=true
*.Designer.cs      linguist-generated=true
