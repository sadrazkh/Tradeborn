{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=tradeborn;Username=postgres;Password=postgres"
  },
  "Tradeborn": {
    "DetailedDbErrors": false,
    "Auth": {
      "Issuer": "tradeborn",
      "Audience": "tradeborn",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "SigningKey": ""
    }
  },
  "AllowedHosts": "*"
}
