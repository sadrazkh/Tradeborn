# ---- .NET ----
# NOTE: do not use bare `[Dd]ebug/` here. It matches ANY directory named `debug`,
# including source folders such as ClientApp/src/game/debug/, which silently drops real
# source from the repository. bin/ and obj/ already cover MSBuild output.
bin/
obj/
*.user
*.suo
.vs/
artifacts/
TestResults/
*.trx
coverage*.json
coverage*.xml
*.coverage

# ---- Node / Vite ----
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- SPA build output served by ASP.NET (generated, never committed) ----
src/Tradeborn.Web/wwwroot/
!src/Tradeborn.Web/wwwroot/.gitkeep

# ---- Secrets / local config ----
*.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/

# ---- Tooling output ----
tools/economy-simulator/out/
playwright-report/
test-results/
